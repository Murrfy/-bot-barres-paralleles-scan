# Zenith 24/7 engine environment
# Copy to /etc/zenith/engine.env, owned by root:zenith and chmod 640.
# Never commit the real bootstrap secret.

ZENITH_BASE_URL=https://zenithfinal3-ahle.vercel.app

# Generate a unique random secret of at least 32 characters.
# It must NOT equal the ADMIN code, pairing code, Binance key, or any other secret.
ZENITH_ENGINE_BOOTSTRAP_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS

# Keep disabled until the cutover checklist is complete.
ZENITH_ENGINE_WORKER_ENABLED=0

# Localhost-only liveness/readiness endpoint.
ZENITH_ENGINE_HEALTH_PORT=8787
